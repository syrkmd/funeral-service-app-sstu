package domain

import "time"

type RequestRecord struct {
	Timestamp         time.Time
	Method            string
	Path              string
	ClientIP          string
	Status            int
	Latency           time.Duration
	BytesIn           int64
	BytesOut          int64
	AccessDecision    string
	RateLimitDecision string
	CacheStatus       string
	UpstreamLatency   time.Duration
}

type AccessDecisionEvent struct {
	IP       string
	Decision string
	RuleID   string
}

type RateLimitDecisionEvent struct {
	IP           string
	RuleID       string
	LimitType    string
	Allowed      bool
	CurrentValue int
}

type UpstreamEvent struct {
	Path       string
	StatusCode int
	Latency    time.Duration
	Error      string
}

type CacheEvent struct {
	Key    string
	Domain string
	Path   string
	Action string
	Rule   string
}

type ClientSnapshot struct {
	IP                  string `json:"ip"`
	Requests            uint64 `json:"requests"`
	BytesIn             uint64 `json:"bytes_in"`
	BytesOut            uint64 `json:"bytes_out"`
	BlockedRequests     uint64 `json:"blocked_requests"`
	RateLimitedRequests uint64 `json:"rate_limited_requests"`
}

type UpstreamSnapshot struct {
	Healthy       bool      `json:"healthy"`
	LatencyMS     float64   `json:"upstream_latency_ms"`
	Errors        uint64    `json:"upstream_errors"`
	LastError     string    `json:"last_upstream_error,omitempty"`
	TotalRequests uint64    `json:"total_upstream_requests"`
	LastStatus    int       `json:"last_upstream_status"`
	LastUpdatedAt time.Time `json:"last_updated_at,omitempty"`
}

type MonitoringSnapshot struct {
	StartedAt                time.Time         `json:"-"`
	TotalRequests            uint64            `json:"total_requests"`
	ActiveRequests           int64             `json:"active_requests"`
	ActiveConnections        int64             `json:"active_connections"`
	TotalBlockedRequests     uint64            `json:"total_blocked_requests"`
	TotalRateLimitedRequests uint64            `json:"total_rate_limited_requests"`
	TotalUpstreamErrors      uint64            `json:"total_upstream_errors"`
	RequestsPerSecond        float64           `json:"requests_per_second"`
	AverageLatencyMS         float64           `json:"average_latency_ms"`
	BytesIn                  uint64            `json:"bytes_in"`
	BytesOut                 uint64            `json:"bytes_out"`
	RequestsByStatus         map[string]uint64 `json:"requests_by_status"`
	RequestsByMethod         map[string]uint64 `json:"requests_by_method"`
	RequestsByPath           map[string]uint64 `json:"requests_by_path"`
	Clients                  []ClientSnapshot  `json:"clients"`
	Upstream                 UpstreamSnapshot  `json:"upstream"`
	AccessDecisionStats      map[string]uint64 `json:"access_decision_stats"`
	MatchedRuleStats         map[string]uint64 `json:"matched_rule_stats"`
	RateLimitViolations      map[string]uint64 `json:"rate_limit_violations"`
	RateLimitedClients       map[string]uint64 `json:"rate_limited_clients"`
	CacheHits                uint64            `json:"cache_hits"`
	CacheMisses              uint64            `json:"cache_misses"`
	CacheStores              uint64            `json:"cache_stores"`
	CacheInvalidations       map[string]uint64 `json:"cache_invalidations"`
}

type MetricsResponse struct {
	Uptime                   string            `json:"uptime"`
	TotalRequests            uint64            `json:"total_requests"`
	ActiveRequests           int64             `json:"active_requests"`
	TotalBlockedRequests     uint64            `json:"total_blocked_requests"`
	TotalRateLimitedRequests uint64            `json:"total_rate_limited_requests"`
	TotalUpstreamErrors      uint64            `json:"total_upstream_errors"`
	RequestsPerSecond        float64           `json:"requests_per_second"`
	AverageLatencyMS         float64           `json:"average_latency_ms"`
	BytesIn                  uint64            `json:"bytes_in"`
	BytesOut                 uint64            `json:"bytes_out"`
	ActiveConnections        int64             `json:"active_connections"`
	RequestsByStatus         map[string]uint64 `json:"requests_by_status"`
	RequestsByMethod         map[string]uint64 `json:"requests_by_method"`
	RequestsByPath           map[string]uint64 `json:"requests_by_path"`
	CacheHits                uint64            `json:"cache_hits"`
	CacheMisses              uint64            `json:"cache_misses"`
	CacheStores              uint64            `json:"cache_stores"`
	CacheInvalidations       map[string]uint64 `json:"cache_invalidations"`
}

type DashboardOverview struct {
	Uptime            string  `json:"uptime"`
	TotalRequests     uint64  `json:"total_requests"`
	CurrentRPS        float64 `json:"current_rps"`
	ActiveConnections int64   `json:"active_connections"`
	BlockedRequests   uint64  `json:"blocked_requests"`
	UpstreamStatus    string  `json:"upstream_status"`
	AverageLatencyMS  float64 `json:"average_latency_ms"`
}

type DashboardClients struct {
	TopClientsByRequests []ClientSnapshot `json:"top_clients_by_requests"`
	TopClientsByTraffic  []ClientSnapshot `json:"top_clients_by_traffic"`
	BlockedClients       []ClientSnapshot `json:"blocked_clients"`
	RateLimitedClients   []ClientSnapshot `json:"rate_limited_clients"`
}

type DashboardUpstream struct {
	Healthy       bool      `json:"upstream_health"`
	LatencyMS     float64   `json:"upstream_latency_ms"`
	Errors        uint64    `json:"upstream_errors"`
	LastError     string    `json:"last_upstream_error,omitempty"`
	TotalRequests uint64    `json:"total_upstream_requests"`
	LastStatus    int       `json:"last_upstream_status"`
	LastUpdatedAt time.Time `json:"last_updated_at,omitempty"`
}

type RateLimitBucketSnapshot struct {
	Key             string    `json:"key"`
	Scope           string    `json:"scope"`
	LimitType       string    `json:"type"`
	Value           string    `json:"value"`
	TokensRemaining float64   `json:"tokens_remaining"`
	LastRefill      time.Time `json:"last_refill"`
}

type BlockedClient struct {
	IP    string `json:"ip"`
	Count uint64 `json:"count"`
}

type DashboardRateLimits struct {
	ActiveRules        []RateLimitRule           `json:"active_rate_limit_rules"`
	CurrentBucketUsage []RateLimitBucketSnapshot `json:"current_bucket_usage"`
	Violations         map[string]uint64         `json:"violations"`
	BlockedIPs         []BlockedClient           `json:"blocked_ips"`
}

type DashboardIPAccess struct {
	Allowlist             []IPRule          `json:"allowlist"`
	Denylist              []IPRule          `json:"denylist"`
	Graylist              []IPRule          `json:"graylist"`
	DenyStatistics        map[string]uint64 `json:"deny_statistics"`
	MatchedRuleStatistics map[string]uint64 `json:"matched_rules_statistics"`
}
